{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tcsay-demo.onrender.com/api/:path*" },
    { "source": "/((?!api/|assets/|icons/|sw.js|manifest.webmanifest|offline.html|logo-tcsay.png|favicon.png).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
