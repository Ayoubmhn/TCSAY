{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://tcsay-club.vercel.app"
      },
      "environment": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://tcsay-club.vercel.app"
      },
      "environment": "production"
    },
    "demo": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://tcsay.vercel.app",
        "APP_VARIANT": "demo"
      }
    }
  }
}
