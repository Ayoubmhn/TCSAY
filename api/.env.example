# Copier en .env puis adapter
NODE_ENV=development
PORT=3000
TZ=Africa/Tunis

# PostgreSQL (docker compose à la racine du dépôt)
DATABASE_URL=postgresql://tcsay:tcsay@localhost:5432/tcsay?schema=public

# Authentification (obligatoire en production : longue chaîne aléatoire)
JWT_SECRET=change-moi-en-production

# Base de PRODUCTION (vraies données) : true = les commandes de démonstration (seed) sont refusées. Voir docs/BASE_DE_DONNEES.md
TCSAY_PRODUCTION=false

# Versions en local (scripts/version.mjs, docs/VERSION_CLUB.md « En local ») :
#   npm run dev:demo → DATABASE_URL_DEMO (données de démo, npm run demo:reset pour les recharger)
#   npm run dev:club → DATABASE_URL_CLUB (la vraie base du club : adresse Neon « Direct connection », secrète)
# DATABASE_URL_DEMO=postgresql://tcsay:tcsay@localhost:5432/tcsay_demo?schema=public
# DATABASE_URL_CLUB=
# Démo EN LIGNE (adresse Neon de tcsay-demo, « Direct connection », secrète) : npm run demo:copy-timetable y recopie
# les emplois du temps de la démo locale. Jamais la base du club.
# DATABASE_URL_DEMO_ONLINE=

# Modules coupés pour cette mise en ligne (version du club, docs/VERSION_CLUB.md), séparés par des virgules.
# Vide = tous les modules. Clés : arabe, budget, disponibilites, import-historique, evaluation-seances, bilans, exercices
MODULES_COUPES=

# Clé de chiffrement des secrets stockés (mot de passe IJIN) : 64 caractères hexadécimaux, à générer une fois avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne jamais la changer ni la committer (les mots de passe déjà enregistrés deviendraient illisibles).
TCSAY_SECRET_KEY=

# Notifications push (Web Push, VAPID). Sans ces lignes, une paire est générée et gardée en base (Setting push.vapid).
# En production, générer une fois (puis ne plus changer : les appareils abonnés devraient se réabonner) :
#   node -e "const c=require('crypto').createECDH('prime256v1');c.generateKeys();console.log('VAPID_PUBLIC_KEY='+c.getPublicKey('base64url')+'\nVAPID_PRIVATE_KEY='+Buffer.concat([Buffer.alloc(32),c.getPrivateKey()]).subarray(-32).toString('base64url'))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@tennisclubdesayada.tn

# Redis (BullMQ, import IA à partir de S9)
REDIS_URL=redis://localhost:6379

# ── Emails (voir docs/MAILING.md) ──
# Développement : Mailpit capture tout (SMTP 1025, interface http://localhost:8025), aucun email ne part.
SMTP_HOST=localhost
SMTP_PORT=1025
# Chiffrement : tls (port 465), starttls (port 587) ou none (Mailpit). Vide = déduit du port.
SMTP_SECURITY=
# Compte SMTP (vide pour Mailpit). Ne jamais committer le vrai mot de passe.
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché (doit être autorisé par le fournisseur : avec Gmail, l'adresse Gmail elle-même).
MAIL_FROM=no-reply@tennisclubdesayada.tn
MAIL_FROM_NAME=Tennis Club de Sayada
# Adresse de réponse (facultatif, ex. l'email du bureau)
MAIL_REPLY_TO=
# Adresse publique du site web : liens « Se connecter » et logo dans les emails
APP_URL=http://localhost:5173

# Exemples de production (décommenter un bloc) :
# Gmail du club (mot de passe d'application, validation en 2 étapes obligatoire ; ~500 emails/jour)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tennisclubsayada@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM=tennisclubsayada@gmail.com
# Brevo (gratuit jusqu'à 300 emails/jour, expéditeur à valider dans Brevo)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=identifiant-smtp@smtp-brevo.com
# SMTP_PASS=cle-smtp-brevo
# Hébergeur du domaine tennisclubdesayada.tn (boîte no-reply@ créée chez l'hébergeur)
# SMTP_HOST=mail.hebergeur.tn
# SMTP_PORT=465
# SMTP_USER=no-reply@tennisclubdesayada.tn
# SMTP_PASS=...

# Envoi par API HTTPS (port 443) quand l'hébergeur bloque les ports SMTP (Render gratuit : 25, 465, 587 bloqués).
# smtp (défaut) | gmail-api | brevo. Guide : docs/MAILING.md › « Render gratuit ».
MAIL_TRANSPORT=smtp
# API Gmail (MAIL_FROM = l'adresse Gmail) : identifiants OAuth et jeton de rafraîchissement (portée gmail.send)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# API Brevo (expéditeur MAIL_FROM validé dans Brevo)
BREVO_API_KEY=

# Application mobile : jeton d'accès Expo facultatif (si « Enhanced security for push » est activé sur expo.dev)
EXPO_ACCESS_TOKEN=

# Origine autorisée pour le front web (Vite)
CORS_ORIGIN=http://localhost:5173

# --- Sécurité (voir docs/SECURITE.md) ---
# Production : adresses autorisées à appeler l'API depuis un autre site (vide = même adresse seulement)
CORS_ORIGIN=
# Derrière un proxy / hébergeur (Render : automatique) : vraie adresse des visiteurs pour la limite d'essais
TRUST_PROXY=false
# Requêtes max par minute et par adresse IP
RATE_LIMIT_PER_MINUTE=300
# Swagger en production (désactivé par défaut)
SWAGGER=false
# Dossier des sauvegardes (ex. dossier Google Drive synchronisé) ; vide = api/backups
BACKUP_DIR=

# --- Lecture des photos du cahier par IA (Gemini, niveau gratuit) ---
# Clé créée sur https://aistudio.google.com (bouton « Get API key »). Vide = bouton désactivé.
# Niveau gratuit : Google peut utiliser les photos envoyées pour améliorer ses produits (le président l'accepte dans l'application).
GEMINI_API_KEY=
# Modèle (laisser vide = gemini-flash-latest, le dernier modèle Flash)
GEMINI_MODEL=

# --- Alertes du serveur sur Telegram (docs/ALERTES_TELEGRAM.md) ---
# Jeton du bot (donné par @BotFather) et identifiant de votre conversation. Vides = aucune alerte.
# Secrets : jamais dans le dépôt, jamais envoyés à personne.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Nom affiché dans les alertes (ex. « TCSAY démo », « TCSAY club ») ; vide = nom du service Render
ALERT_INSTANCE=
# false = pas d'alerte au démarrage du serveur ; false = pas d'alerte pour les emails non envoyés (démo sans emails)
ALERT_ON_START=
ALERT_MAIL=
