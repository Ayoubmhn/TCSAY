{
  "name": "tcsay-api",
  "version": "0.0.1",
  "private": true,
  "description": "API du Tennis Club de Sayada",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "prestart": "prisma generate || echo \"Client Prisma non régénéré (une API tourne déjà ?) : on continue.\"",
    "start": "nest start",
    "prestart:dev": "prisma generate || echo \"Client Prisma non régénéré (une API tourne déjà ?) : on continue.\"",
    "start:dev": "nest start --watch",
    "dev:demo": "node scripts/version.mjs demo",
    "dev:club": "node scripts/version.mjs club",
    "demo:reset": "node scripts/version.mjs demo db:demo",
    "demo:migrate": "node scripts/version.mjs demo prisma:deploy",
    "prisma:deploy": "prisma migrate deploy",
    "demo:status": "node scripts/version.mjs demo db:status",
    "club:status": "node scripts/version.mjs club db:status",
    "club:migrate": "node scripts/version.mjs club db:migrate",
    "club:backup": "node scripts/version.mjs club db:backup",
    "club:set-password": "node scripts/version.mjs club db:set-password",
    "db:update": "node prisma/db-tools.mjs migrate",
    "db:migrate": "node prisma/db-tools.mjs migrate",
    "db:status": "node prisma/db-tools.mjs status",
    "db:backup": "node prisma/db-tools.mjs backup",
    "db:restore": "node prisma/db-tools.mjs restore",
    "db:init-prod": "node prisma/init-prod.mjs",
    "db:set-password": "node prisma/set-password.mjs",
    "db:demo": "prisma migrate deploy && prisma generate && prisma db seed",
    "start:prod": "node dist/main",
    "start:demo": "prisma migrate deploy && node prisma/seed-if-empty.mjs && node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:score": "node test/score-engine.check.cjs",
    "test:push": "node test/web-push.check.cjs",
    "test:alerts": "node --test test/alerts.check.mjs",
    "test:modules": "node --test test/modules.check.mjs",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.e2e.mjs\"",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
