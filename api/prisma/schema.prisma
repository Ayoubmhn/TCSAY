// Schéma TCSAY : modèle de données complet (CLAUDE.md §7).
// Montants en dinars tunisiens, 3 décimales (millimes). Dates sans heure en @db.Date (minuit UTC).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Énumérations ─────────────────────────

enum Role {
  ADMIN
  COACH
  PARENT
  PLAYER
}

enum Gender {
  M
  F
  MIXED // catégories uniquement
}

enum CategoryFamily {
  YOUTH // Jeunes
  ADULT // Adultes
  VETERAN // Vétérans
  CORPORATE // Entreprise
  PADEL // Padel
}

enum SeasonStatus {
  DRAFT // Brouillon
  ACTIVE // Active (une seule à la fois, R2)
  CLOSED // Clôturée (verrouillée, R1)
  HISTORICAL // Historique (verrouillée, R1)
}

enum ReservationType {
  LEISURE // Loisir (joueur, parent)
  PRIVATE // Séance privée (coach avec un élève)
}

enum RatePeriod {
  DAY // Jour
  NIGHT // Nuit (dès l'heure de nuit paramétrée)
}

enum PaymentKind {
  PAYMENT // Encaissement
  REFUND // Remboursement (montant négatif, R7)
  CORRECTION // Écriture corrective (R7)
}

enum PaymentMethod {
  CASH // Espèces (saisies par l'admin)
  ONLINE // En ligne (passerelle à choisir, S6)
}

enum Origin {
  MANUAL
  IMPORT // R14
}

enum EmailKind {
  CREDENTIALS // Identifiants
  REMINDER // Rappel
  SALARY // Salaire
  RESERVATION // Réservation
  OTHER
}

enum EmailStatus {
  SENT
  FAILED
}

enum ImportStatus {
  PENDING
  PROCESSING
  REVIEW
  DONE
  FAILED
}

// ───────────────────────── Comptes ─────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String
  role               Role
  firstName          String
  lastName           String
  phone              String?
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true) // comptes désactivés, jamais supprimés
  lastLoginAt        DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  player        Player?
  coach         Coach?
  parentLinks   ParentLink[]
  auditLogs     AuditLog[]
  reservations  Reservation[] @relation("ReservationBookedBy")
  cancellations Reservation[] @relation("ReservationCancelledBy")
  payments      Payment[]
  attendances   Attendance[]
}

model Player {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @unique @db.Uuid // compte propre (adulte) ; mineur : à confirmer
  firstName  String
  lastName   String
  birthDate  DateTime  @db.Date
  gender     Gender // M ou F
  email      String?
  phone      String?
  photoUrl   String?
  origin     Origin    @default(MANUAL)
  archivedAt DateTime? // R8
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  parentLinks  ParentLink[]
  enrollments  Enrollment[]
  reservations Reservation[]
  attendances  Attendance[]

  @@index([lastName, firstName])
}

model ParentLink {
  parentId  String   @db.Uuid
  playerId  String   @db.Uuid
  createdAt DateTime @default(now())

  parent User   @relation(fields: [parentId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@id([parentId, playerId])
}

model Coach {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  payMode   String? // mensuel, horaire, forfait : à confirmer
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id])
  groups       TrainingGroup[]
  fees         CoachFee[]
  reservations Reservation[]
}

// ───────────────────────── Saisons et catégories ─────────────────────────

model Season {
  id         String       @id @default(uuid()) @db.Uuid
  label      String       @unique // ex. « 2026-2027 »
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date
  status     SeasonStatus @default(DRAFT)
  archivedAt DateTime? // R8 : suppression = archivage
  version    Int          @default(1) // R13 : verrouillage optimiste
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  enrollments   Enrollment[]
  groups        TrainingGroup[]
  feeSchedules  FeeSchedule[]
  coachFees     CoachFee[]
  importBatches ImportBatch[]

  @@index([status])
}

model Category {
  id         String         @id @default(uuid()) @db.Uuid
  code       String         @unique // ex. J12M
  name       String // ex. « Benjamins (-12) »
  family     CategoryFamily
  gender     Gender
  pairCode   String // ex. J12 (paire garçon / fille)
  maxAge     Int? // jeunes : âge strictement inférieur
  minAge     Int? // vétérans : âge minimum
  note       String? // point à confirmer avec le bureau
  sortOrder  Int            @default(0)
  archivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  enrollments  Enrollment[]
  groups       TrainingGroup[]
  feeSchedules FeeSchedule[]
}

model Enrollment {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  seasonId         String   @db.Uuid
  categoryId       String   @db.Uuid
  derogationReason String? // catégorie hors norme (R3)
  origin           Origin   @default(MANUAL)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  player     Player        @relation(fields: [playerId], references: [id])
  season     Season        @relation(fields: [seasonId], references: [id])
  category   Category      @relation(fields: [categoryId], references: [id])
  membership Membership?
  groups     GroupMember[]

  @@unique([playerId, seasonId]) // une catégorie par saison
}

// ───────────────────────── Groupes et terrains ─────────────────────────

model Court {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  surface     String
  lit         Boolean  @default(false) // éclairé : réservable la nuit
  active      Boolean  @default(true) // R11
  maintenance Boolean  @default(false)
  sortOrder   Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups       TrainingGroup[]
  reservations Reservation[]
}

model TrainingGroup {
  id         String    @id @default(uuid()) @db.Uuid
  seasonId   String    @db.Uuid
  name       String
  categoryId String    @db.Uuid
  coachId    String?   @db.Uuid
  courtId    String?   @db.Uuid
  days       Int[] // jours de la semaine : 0 = dimanche … 6 = samedi
  startTime  String // « 17:00 »
  endTime    String // « 18:30 »
  capacity   Int
  archivedAt DateTime?
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  season       Season        @relation(fields: [seasonId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  coach        Coach?        @relation(fields: [coachId], references: [id])
  court        Court?        @relation(fields: [courtId], references: [id])
  members      GroupMember[]
  attendances  Attendance[]
  reservations Reservation[]
  feeSchedules FeeSchedule[]

  @@unique([seasonId, name])
}

model GroupMember {
  id               String   @id @default(uuid()) @db.Uuid
  groupId          String   @db.Uuid
  enrollmentId     String   @db.Uuid
  derogationReason String? // R4 : catégorie différente
  createdAt        DateTime @default(now())

  group      TrainingGroup @relation(fields: [groupId], references: [id])
  enrollment Enrollment    @relation(fields: [enrollmentId], references: [id])

  @@unique([groupId, enrollmentId])
}

// ───────────────────────── Réservations ─────────────────────────

model CourtRate {
  id           String          @id @default(uuid()) @db.Uuid
  type         ReservationType
  period       RatePeriod
  pricePerHour Decimal         @db.Decimal(10, 3)
  version      Int             @default(1)
  updatedAt    DateTime        @updatedAt

  @@unique([type, period])
}

model Reservation {
  id            String          @id @default(uuid()) @db.Uuid
  courtId       String          @db.Uuid
  playerId      String?         @db.Uuid
  coachId       String?         @db.Uuid
  groupId       String?         @db.Uuid
  type          ReservationType
  startTime     DateTime
  endTime       DateTime
  price         Decimal         @db.Decimal(10, 3)
  bookedById    String          @db.Uuid
  activeKey     String?         @unique // « courtId|startISO » ; null à l'annulation
  cancelledAt   DateTime?
  cancelledById String?         @db.Uuid
  cancelReason  String?
  createdAt     DateTime        @default(now())

  court       Court          @relation(fields: [courtId], references: [id])
  player      Player?        @relation(fields: [playerId], references: [id])
  coach       Coach?         @relation(fields: [coachId], references: [id])
  group       TrainingGroup? @relation(fields: [groupId], references: [id])
  bookedBy    User           @relation("ReservationBookedBy", fields: [bookedById], references: [id])
  cancelledBy User?          @relation("ReservationCancelledBy", fields: [cancelledById], references: [id])

  @@index([startTime])
}

// ───────────────────────── Cotisations et paiements ─────────────────────────

model FeeSchedule {
  id                String   @id @default(uuid()) @db.Uuid
  seasonId          String   @db.Uuid
  categoryId        String   @db.Uuid
  groupId           String?  @db.Uuid
  amount            Decimal  @db.Decimal(10, 3)
  installmentsCount Int
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  season      Season         @relation(fields: [seasonId], references: [id])
  category    Category       @relation(fields: [categoryId], references: [id])
  group       TrainingGroup? @relation(fields: [groupId], references: [id])
  memberships Membership[]

  @@unique([seasonId, categoryId, groupId])
}

model Membership {
  id            String   @id @default(uuid()) @db.Uuid
  enrollmentId  String   @unique @db.Uuid
  feeScheduleId String?  @db.Uuid
  totalAmount   Decimal  @db.Decimal(10, 3)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  feeSchedule  FeeSchedule?  @relation(fields: [feeScheduleId], references: [id])
  installments Installment[]
}

model Installment {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @db.Uuid
  number       Int // 1
  count        Int // sur 2
  dueDate      DateTime @db.Date
  amount       Decimal  @db.Decimal(10, 3)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id])
  payments   Payment[]

  @@unique([membershipId, number])
}

/// R7 : jamais modifié ni supprimé (pas de updatedAt).
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  installmentId String        @db.Uuid
  amount        Decimal       @db.Decimal(10, 3)
  kind          PaymentKind   @default(PAYMENT)
  method        PaymentMethod @default(CASH)
  paidAt        DateTime      @default(now())
  recordedById  String        @db.Uuid
  note          String?
  origin        Origin        @default(MANUAL)
  createdAt     DateTime      @default(now())

  installment Installment @relation(fields: [installmentId], references: [id])
  recordedBy  User        @relation(fields: [recordedById], references: [id])
}

// ───────────────────────── Coachs ─────────────────────────

model CoachFee {
  id        String    @id @default(uuid()) @db.Uuid
  coachId   String    @db.Uuid
  seasonId  String    @db.Uuid
  period    String // ex. « Octobre 2026 »
  amount    Decimal   @db.Decimal(10, 3)
  paidAt    DateTime? @db.Date // null = À verser
  note      String?
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  coach  Coach  @relation(fields: [coachId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([coachId, seasonId, period])
}

model Attendance {
  id           String   @id @default(uuid()) @db.Uuid
  groupId      String   @db.Uuid
  playerId     String   @db.Uuid
  date         DateTime @db.Date
  present      Boolean
  reason       String? // motif d'absence
  recordedById String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group      TrainingGroup @relation(fields: [groupId], references: [id])
  player     Player        @relation(fields: [playerId], references: [id])
  recordedBy User          @relation(fields: [recordedById], references: [id])

  @@unique([groupId, playerId, date])
}

// ───────────────────────── Divers ─────────────────────────

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  date      DateTime @db.Date
  place     String
  tag       String // ex. « Tournoi »
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Paramètres modifiables par l'admin (délai d'annulation, début de la nuit…).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String // ex. « Saison activée »
  entity    String // ex. « Season »
  entityId  String?
  target    String // libellé lisible
  before    String?
  after     String?
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model EmailLog {
  id        String      @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  body      String
  kind      EmailKind
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

// ───────────────────────── Import historique (S9) ─────────────────────────

model ImportBatch {
  id        String       @id @default(uuid()) @db.Uuid
  seasonId  String?      @db.Uuid
  label     String
  status    ImportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  season Season?       @relation(fields: [seasonId], references: [id])
  pages  ScannedPage[]
}

model ScannedPage {
  id         String   @id @default(uuid()) @db.Uuid
  batchId    String   @db.Uuid
  pageNumber Int
  storageKey String // clé du scan dans le stockage S3 (R2)
  createdAt  DateTime @default(now())

  batch   ImportBatch       @relation(fields: [batchId], references: [id])
  records ExtractedRecord[]
}

model ExtractedRecord {
  id          String    @id @default(uuid()) @db.Uuid
  pageId      String    @db.Uuid
  kind        String // joueur, paiement…
  data        Json
  confidence  Float?
  validatedAt DateTime? // R14 : validation humaine obligatoire
  createdAt   DateTime  @default(now())

  page ScannedPage @relation(fields: [pageId], references: [id])
}
